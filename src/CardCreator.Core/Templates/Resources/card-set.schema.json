{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Card set definition",
  "type": "object",
  "required": [ "output_file_path", "output_format", "page_orientation", "game", "card_type", "card_size", "with_backs", "cards" ],
  "properties": {
    "output_file_path": { "type": "string", "minLength": 1, "pattern": "\\.pdf$" },
    "output_format": { "type": "string", "enum": [ "A4" ] },
    "page_orientation": { "type": "string", "enum": [ "auto", "portrait", "landscape" ] },
    "game": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "minLength": 1 },
    "card_type": { "type": "string", "minLength": 1 },
    "card_size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?x[0-9]+(\\.[0-9]+)?mm$" },
    "with_backs": { "type": "boolean" },
    "cards": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  },
  "additionalProperties": false
}
