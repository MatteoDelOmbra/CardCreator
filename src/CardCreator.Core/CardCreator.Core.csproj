<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.2" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.5.0" />
    <!-- Overrides vulnerable 8.0.1 pulled in transitively by PDFsharp -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Templates are embedded with '/' separated logical names, e.g. "Templates/ImperiumMaledictum/game.json" -->
    <EmbeddedResource Include="Templates\Resources\**\*">
      <LogicalName>Templates/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
